{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": false,
      "previewPath": null,
      "fields": [
        {
          "title": "title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "sort_by",
          "name": "sort_by",
          "type": "string"
        },
        {
          "title": "date",
          "name": "date",
          "type": "datetime"
        },
        {
          "title": "draft",
          "name": "draft",
          "type": "draft"
        },
        {
          "title": "weight",
          "name": "weight",
          "type": "number"
        },
        {
          "title": "serial",
          "name": "serial",
          "type": "number"
        },
        {
          "title": "isCJKLanguage",
          "name": "isCJKLanguage",
          "type": "boolean"
        },
        {
          "title": "headless",
          "name": "headless",
          "type": "boolean"
        },
        {
          "title": "keywords",
          "name": "keywords",
          "type": "choice",
          "choices": [
            "static site hosting",
            "best free hosting",
            "cloudflare pages",
            "github pages",
            "wasmer edge",
            "vercel",
            "netlify"
          ]
        },
        {
          "title": "preview",
          "name": "preview",
          "type": "string"
        },
        {
          "title": "taxonomies",
          "name": "taxonomies",
          "type": "fields",
          "fields": [
            {
              "title": "tags",
              "name": "tags",
              "type": "tags"
            }
          ]
        }
      ]
    }
  ],
  "frontMatter.framework.id": "other",
  "frontMatter.content.publicFolder": "",
  "frontMatter.content.pageFolders": [
    {
      "title": "content",
      "path": "[[workspace]]/content"
    },
    {
      "title": "misc",
      "path": "[[workspace]]/content/misc"
    },
    {
      "title": "comparison",
      "path": "[[workspace]]/content/comparison"
    },
    {
      "title": "blog",
      "path": "[[workspace]]/content/blog"
    },
    {
      "title": "newsy",
      "path": "[[workspace]]/content/misc/newsy"
    }
  ]
}